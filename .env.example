# ============================================================
# FORDELSKLUBBEN — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed.
#
# MIGRATION NOTE:
#   - DATABASE_URL and DIRECT_URL: Replace with your own PostgreSQL
#     connection strings when migrating away from Supabase.
#   - NEXT_PUBLIC_SUPABASE_*: Remove entirely when migrating away from Supabase Auth.
#   - Only ADMIN_JWT_SECRET and NEXT_PUBLIC_APP_URL carry over unchanged.
# ============================================================

# --- Database (Supabase PostgreSQL via Prisma) ---
# Get these from: Supabase Dashboard → Project Settings → Database → Connection string
# Use the "Transaction mode" URL for DATABASE_URL (pooled, for runtime queries).
# Use the "Session mode" URL for DIRECT_URL (direct, for Prisma migrations).
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-north-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-north-1.pooler.supabase.com:5432/postgres"

# --- Supabase Auth & Storage ---
# Get these from: Supabase Dashboard → Project Settings → API
# MIGRATION NOTE: Remove these when migrating to a different auth/storage provider.
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Admin Authentication ---
# A long random secret used to sign admin JWTs.
# Generate with: openssl rand -base64 32
ADMIN_JWT_SECRET="replace-with-long-random-secret"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
