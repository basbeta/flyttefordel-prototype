# ============================================================
# FORDELSKLUBBEN — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed.
#
# CR-011: migrated from Vercel + Supabase to Hetzner/Coolify.
# Supabase Auth/Storage vars removed — never used anywhere in src/.
# ============================================================

# --- Database (self-hosted PostgreSQL on Coolify, via Prisma) ---
# connect_timeout / socket_timeout are appended automatically by
# src/lib/db/client.ts if not present in the URL — safe to add them
# explicitly here too.
DATABASE_URL="postgresql://user:password@host:5432/fordelsklubben?connect_timeout=10&socket_timeout=10"
DIRECT_URL="postgresql://user:password@host:5432/fordelsklubben"

# --- Admin Authentication ---
# A long random secret used to sign admin JWTs.
# Generate with: openssl rand -base64 32
ADMIN_JWT_SECRET="replace-with-long-random-secret"
ADMIN_EMAILS="admin@example.com"
ADMIN_PASSWORD="replace-with-a-real-password"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
