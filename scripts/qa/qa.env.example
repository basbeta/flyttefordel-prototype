# Kopier til .env.qa i rotmappen (den er gitignored via .env.*). Aldri commit ekte verdier.
# Brukes av scripts/qa/smoke.py og test-agenten (.claude/agents/e2e-tester.md).

# Hvilken app som testes. Standard er prod-prototypen.
QA_BASE_URL=https://flyttefordel-prototype.basbeta.no

# Egen admin-innlogging for test-agenten (valgfritt, admin-delen hoppes over uten).
# E-posten må ligge i ADMIN_EMAILS i Coolify (kommaseparert), passordet er det delte ADMIN_PASSWORD.
QA_ADMIN_EMAIL=
QA_ADMIN_PASSWORD=
